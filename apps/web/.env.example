# =============================================================================
# My Team Web - Environment Variables
# =============================================================================

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myteam"

# Planning Center API credentials (for server-side reads and sync helpers)
# Create or copy a Planning Center Personal Access Token:
#   Planning Center > Developer Applications > Personal Access Tokens
# Use the token app ID as PCO_API_ID and token secret as PCO_API_SECRET.
PCO_API_ID=""
PCO_API_SECRET=""

# Rock RMS API credentials.
# ROCK_BASE_URL: the base URL for the church's Rock instance, without a trailing slash.
# ROCK_API_KEY: create or copy a read-only REST key in Rock:
#   Rock > Admin Tools > Security > REST Keys
# Then grant only the API/controller permissions needed for discovery/sync:
#   Rock > Admin Tools > Security > REST Controllers
# Keep real Rock values in .env.local, Railway variables, or a secret manager.
# Never commit REST keys.
ROCK_BASE_URL=""
ROCK_API_KEY=""

# Optional comma-separated Rock group type IDs that should sync into My Team.
# EV Church serving teams use 23 (Serving Team) and 40 (Area).
ROCK_TEAM_GROUP_TYPE_IDS="23,40"

# Auth.js session secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Auth0 OAuth/OIDC credentials (for user login).
# Create or open an Auth0 Regular Web Application in the Auth0 dashboard.
# AUTH0_DOMAIN: Auth0 Dashboard > Applications > your app > Settings > Domain.
# AUTH0_CLIENT_ID: same Settings page > Client ID.
# AUTH0_CLIENT_SECRET: same Settings page > Client Secret.
# APP_BASE_URL: this app's public origin. Auth0 redirects back to this app, so
# it should match the domain used in your Auth0 callback/logout/web-origin URLs.
#
# In the Auth0 app settings for local development, configure:
# Allowed Callback URLs: http://localhost:7500/api/auth/callback/auth0
# Allowed Logout URLs: http://localhost:7500
# Allowed Web Origins: http://localhost:7500
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
APP_BASE_URL="http://localhost:7500"

# S3-compatible guide image uploads.
# Railway buckets expose S3-compatible credentials; map them to these vars.
# For local testing without a container, run `pnpm dev:s3` and use:
# S3_ENDPOINT="http://127.0.0.1:4568"
# S3_REGION="us-east-1"
# S3_BUCKET="my-team-local"
# S3_ACCESS_KEY_ID="S3RVER"
# S3_SECRET_ACCESS_KEY="S3RVER"
# S3_PUBLIC_URL="http://127.0.0.1:4568/my-team-local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public bucket/base URL used after upload, without a trailing slash.
S3_PUBLIC_URL=""

# Railway-specific (set in dashboard, not in .env)
# HOSTNAME=0.0.0.0              # Required for standalone Next.js on Railway
# SKIP_ENV_VALIDATION=1         # Skip env validation during build phase
