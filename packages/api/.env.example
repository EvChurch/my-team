# PostgreSQL connection string for Prisma CLI commands
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myteam"

# S3-compatible guide image uploads.
# For local testing without a container, run `pnpm dev:s3`.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
